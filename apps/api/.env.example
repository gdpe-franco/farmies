# Public Supabase project URL.
SUPABASE_URL="http://127.0.0.1:54321"
# Worker-only secret used to delete Auth identities. Never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY="replace-with-local-service-role-key"
CLIENT_ORIGIN="http://localhost:9000"

# Docker-only JWKS address; token issuer validation still uses SUPABASE_URL.
SUPABASE_JWKS_URL="http://host.docker.internal:54321/auth/v1/.well-known/jwks.json"

# Local-only database URL used by Wrangler for the HYPERDRIVE binding.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgresql://LOGIN:PASSWORD@host.docker.internal:54322/postgres"
